# Cloud backend for models too big to fit in local RAM. Configure ONE of the three below —
# preference order (see technique_selector.py's _cloud_backend()) is Colab > ZeroGPU > Tinker.

# --- Option A (preferred): Google Colab — genuinely free, no billing, no account-age gate ---
# One-time setup (can't be done for you — it's an OAuth consent tied to your Google account):
#   uv tool install google-colab-cli
#   colab sessions   # open the printed URL, approve, paste the code back
# Then set this to enable it:
AUTOTUNELAB_USE_COLAB=

# --- Option B: HF ZeroGPU (free, but needs an HF account 30+ days old) ---
# Token from https://huggingface.co/settings/tokens (role: Write)
HF_TOKEN=
# The Space hosting zerogpu_space/, e.g. "your-hf-username/autotunelab-zerogpu-trainer".
# Deploy it with: backend/.venv/bin/python backend/scripts/deploy_zerogpu_space.py
HF_ZEROGPU_SPACE_ID=

# --- Option C: Tinker (no daily cap, but requires billing) ---
TINKER_API_KEY=

# Optional: override the model used for goal-parsing / synthetic data / LLM-judging
# (used by whichever of the two backends above is active).
TINKER_JUDGE_MODEL=Qwen/Qwen3-8B
